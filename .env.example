# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (leave empty to keep the outbox publisher idle)
# Host/dev: use the host listener 9093; containers use kafka:9092 internally.
KAFKA_BROKERS=localhost:9093

# JWT (plain seconds or a timespan such as 15m / 7d)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRATION=7d

# OAuth2 Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth2/google/callback

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@ticket-platform.local
SMTP_MODE=smtp

# HTTP
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Seed accounts password (default: ChangeMe123!)
SEED_PASSWORD=ChangeMe123!
